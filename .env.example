# Copie para .env e rode: chmod 600 .env  — nunca commitar.
# Fase 2: bot dedicado de aprovação (BotFather)
AGENCIA_TELEGRAM_BOT_TOKEN=
# Fase 2: deixe AGENCIA_LLM_BASE_URL vazio → modo delegação (o DUDS chama delegate_task; D1c).
# Só preencha se um dia houver um endpoint OpenAI-compatível (o hermes proxy NÃO serve: só nous/xai).
AGENCIA_LLM_BASE_URL=
AGENCIA_LLM_API_KEY=
# Fase 3: render no host. Dentro do container do DUDS, apontar para o serviço; no host pode ficar vazio (render local)
AGENCIA_RENDER_URL=http://127.0.0.1:8766
AGENCIA_RENDER_TOKEN=
# Opcional: caminho do binário do Chromium se a descoberta automática falhar
AGENCIA_CHROMIUM=
# Fase 4: Python do venv do MCP google-ads (tem a biblioteca google-ads); mesmo caminho no host e no container
AGENCIA_ADS_PYTHON=/root/.hermes/profiles/duds/lib/google-ads-mcp/venv/bin/python
# Se o venv acima não for executável no host, a leitura roda via docker exec neste container
AGENCIA_DUDS_CONTAINER=hermes-gateway-duds
# Fase 5: Instagram (P3). Token de longa duração ou de usuário de sistema do app Meta; ID da conta Instagram Profissional
AGENCIA_IG_TOKEN=
AGENCIA_IG_USER_ID=
AGENCIA_GRAPH_VERSION=v23.0
# Onde as PNGs ficam públicas para a API buscar (nginx; ver deploy/nginx-agencia-midia.conf)
AGENCIA_MIDIA_DIR=/var/www/agencia-midia
AGENCIA_MIDIA_BASE_URL=https://hermes.caixadeprioridades.com.br/agencia-midia
