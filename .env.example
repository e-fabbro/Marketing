# Copie para .env e rode: chmod 600 .env  — nunca commitar.
# Fase 2: bot dedicado de aprovação (BotFather)
AGENCIA_TELEGRAM_BOT_TOKEN=
# Fase 2: deixe AGENCIA_LLM_BASE_URL vazio → modo delegação (o DUDS chama delegate_task; D1c).
# Só preencha se um dia houver um endpoint OpenAI-compatível (o hermes proxy NÃO serve: só nous/xai).
AGENCIA_LLM_BASE_URL=
AGENCIA_LLM_API_KEY=
# Fase 3: render no host. Dentro do container do DUDS, apontar para o serviço; no host pode ficar vazio (render local)
AGENCIA_RENDER_URL=http://127.0.0.1:8766
AGENCIA_RENDER_TOKEN=
# Opcional: caminho do binário do Chromium se a descoberta automática falhar
AGENCIA_CHROMIUM=
